{
    "name": "soramugi/google-drive-client-php",
    "type": "library",
    "keywords": ["google", "drive", "spreadsheet"],
    "license": "Apache",
    "require": {
        "soramugi/google-api": "0.6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "cweagans/composer-patches": "^1.7"
    },
    "extra": {
        "patches": {
            "soramugi/google-api": {
                "Fix PHP 8 incompatible curly-brace string offset access": "patches/soramugi-google-api-php8-compat.patch"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "authors": [
        {
            "name": "soramugi",
            "email": "soramugi.chika@gmail.com"
        }
    ],
    "autoload": {
        "psr-0": { "Soramugi\\GoogleDrive": "src/" }
    }
}
