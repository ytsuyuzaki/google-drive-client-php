<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="true" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnError="false" stopOnFailure="false" stopOnIncomplete="false" stopOnSkipped="false">
  <testsuites>
    <testsuite name="Soramugi\\GoogleDrive Test Suite">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <logging>
    <junit outputFile="builds/logs/junit.xml"/>
  </logging>
  <coverage>
    <report>
      <html outputDirectory="builds/coverage" lowUpperBound="35" highLowerBound="70"/>
      <clover outputFile="builds/logs/clover.xml"/>
    </report>
  </coverage>
  <source>
    <include>
      <directory suffix=".php">src</directory>
    </include>
    <exclude>
      <directory>tests</directory>
      <directory>builds</directory>
      <directory>vendor</directory>
      <directory>examples</directory>
    </exclude>
  </source>
</phpunit>
